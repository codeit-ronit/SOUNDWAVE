# Development defaults. Never commit a real .env file.
PORT=3001
APP_ORIGIN=http://localhost:3001
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
HTTP_LOG=0

# Set DATABASE_URL to use PostgreSQL. Otherwise local development retains SQLite.
# DATABASE_URL=postgres://soundwave:YOUR_URL_ENCODED_PASSWORD@localhost:5432/soundwave
# DATABASE_PATH=/absolute/persistent/path/soundwave.sqlite
DB_POOL_MAX=5
# Set for managed PostgreSQL requiring verified TLS (system/extra trusted CAs).
PGSSL=false

# Anonymous visitors get independent guest accounts, never a shared user bypass.
DEMO_MODE=true
SESSION_TTL_SECONDS=604800
GUEST_TTL_SECONDS=86400

# Docker Compose: use a strong URL-safe value; percent-encode reserved URL characters.
# POSTGRES_PASSWORD=replace-with-a-strong-local-password
# APP_NODE_ENV=development

# Production: NODE_ENV=production, APP_ORIGIN=https://your-exact-host,
# DATABASE_URL and usually PGSSL=true. Local HTTP Compose uses development cookies.
# ALLOW_EPHEMERAL_SQLITE=true is an explicit portfolio-only fallback, not durable hosting.

# Phase 2: shared API/auth limits. Omit REDIS_URL for local in-process limits.
# Compose supplies its internal redis://redis:6379 URL automatically.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=soundwave
# Opt-in: the six-story local benchmark showed Redis overhead, not a speedup.
CATALOG_CACHE=false
# Exact IPs/CIDRs of your actual proxy only; never true or a /0 network.
TRUSTED_PROXY_CIDRS=

# Delivery is explicit: disabled reports 503 for recovery requests, never fake success.
EMAIL_MODE=disabled
# For Compose, leave SMTP_URL unset to use smtp://mailpit:1025.
# For host-side Node development, use smtp://127.0.0.1:1025.
# SMTP_URL=smtp://127.0.0.1:1025
# Production accepts implicit TLS smtps:// with certificate verification.
MAIL_FROM=SoundWave <noreply@soundwave.local>
# Required with EMAIL_MODE=smtp; generate 32 cryptographically random bytes as hex.
# EMAIL_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTERS

# Backup operator tooling (PostgreSQL public schema only).
# PG_DUMP_BIN=/path/to/postgresql-18/bin/pg_dump
# PG_RESTORE_BIN=/path/to/postgresql-18/bin/pg_restore
# Optional local Docker tools instead of installing matching native binaries:
# BACKUP_PG_CONTAINER=your-postgres-container
# RESTORE_ADMIN_URL=postgres://createdb-operator:password@host/source_database
