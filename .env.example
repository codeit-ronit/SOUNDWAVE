# Development defaults. Never commit a real .env file.
PORT=3001
APP_ORIGIN=http://localhost:3001
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
HTTP_LOG=0

# Set DATABASE_URL to use PostgreSQL. Otherwise local development retains SQLite.
# DATABASE_URL=postgres://soundwave:YOUR_URL_ENCODED_PASSWORD@localhost:5432/soundwave
# DATABASE_PATH=/absolute/persistent/path/soundwave.sqlite
DB_POOL_MAX=5
# Set for managed PostgreSQL requiring verified TLS (system/extra trusted CAs).
PGSSL=false

# Anonymous visitors get independent guest accounts, never a shared user bypass.
DEMO_MODE=true
SESSION_TTL_SECONDS=604800
GUEST_TTL_SECONDS=86400

# Docker Compose: use a strong URL-safe value; percent-encode reserved URL characters.
# POSTGRES_PASSWORD=replace-with-a-strong-local-password
# APP_NODE_ENV=development

# Production: NODE_ENV=production, APP_ORIGIN=https://your-exact-host,
# DATABASE_URL and usually PGSSL=true. Local HTTP Compose uses development cookies.
# ALLOW_EPHEMERAL_SQLITE=true is an explicit portfolio-only fallback, not durable hosting.
