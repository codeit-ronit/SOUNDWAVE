{
  "name": "soundwave",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:api": "npm run test -w server",
    "seed": "npm run seed -w server",
    "audio:generate": "node server/scripts/generate-audio.js",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"client/*.{js,html,json}\" \"client/public/*.js\" \"client/public/*.html\" \"client/public/*.webmanifest\" \"server/**/*.js\" \"api/*.js\" \"scripts/*.mjs\" \"*.{json,md}\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"client/*.{js,html,json}\" \"client/public/*.js\" \"client/public/*.html\" \"client/public/*.webmanifest\" \"server/**/*.js\" \"api/*.js\" \"scripts/*.mjs\" \"*.{json,md}\"",
    "test:offline": "npm run build && node scripts/offline-smoke.mjs",
    "test:audit": "npm run build && node scripts/audit-smoke.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "22.x"
  }
}
