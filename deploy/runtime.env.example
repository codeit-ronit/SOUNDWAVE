APP_ORIGIN=https://replace-with-approved-host.example
DATABASE_URL=postgres://soundwave_runtime:URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/soundwave
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379
REDIS_PREFIX=soundwave-release
DB_POOL_MAX=3
DEMO_MODE=true
CATALOG_CACHE=true
MEDIA_JOBS=true
LIBRIVOX_CATALOG=false
EMAIL_MODE=disabled
