# Compose interpolation only. Do not commit filled secrets. Paths are host absolute.
RUNTIME_ENV_FILE=/etc/soundwave/runtime.env
MIGRATION_ENV_FILE=/etc/soundwave/migrator.env
POSTGRES_ENV_FILE=/etc/soundwave/postgres.env
REDIS_CONFIG_FILE=/etc/soundwave/redis.conf
RELEASE_HOST=replace-with-approved-host.example
ACME_EMAIL=replace-with-approved-contact@example.com
# Default closed. Explicitly change only after migration/restore/review checks.
RELEASE_QUARANTINED=true
